# Copy to .env (gitignored) and fill in. Never commit .env.

# --- required ---
API_TOKEN=            # openssl rand -hex 24  (callers send it as a Bearer token)
HOST_IP=              # LAN IP of the machine running the bridge; speakers fetch clips from it

# --- optional: ElevenLabs, only for POST /announce {"text": ...} straight to the bridge ---
# (the MCP Worker makes speech with Workers AI and doesn't need this)
ELEVENLABS_API_KEY=
# Public id of the premade "George" voice (not a secret); pick another from the ElevenLabs voice library
ELEVENLABS_VOICE_ID=JBFqnCBsd6RMkjVDRZzb   # gitleaks:allow
ELEVENLABS_MODEL=eleven_flash_v2_5         # lowest latency; eleven_multilingual_v2 for quality

# --- optional ---
FREESOUND_API_KEY=    # https://freesound.org/apiv2/apply — adds Freesound to sound search (BBC needs no key)
DEFAULT_VOLUME=35
PORT=8765
LOG_LEVEL=INFO

# --- tunnel (only with `docker compose --profile tunnel up`) ---
TUNNEL_TOKEN=
